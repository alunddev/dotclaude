      "Bash(black:*)",
      "Bash(go:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",
      "Bash(bundle:*)",
      "Bash(rake:*)",
      "Bash(rails:*)",
      "Bash(composer:*)",
