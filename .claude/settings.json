      "Bash(tar:*)",
      "Bash(gzip:*)",
      "Bash(brew:*)",
      "Bash(apt:*)",
      "Bash(snap:*)",
      "Bash(systemctl:*)",
      "Bash(journalctl:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(top:*)",
      "Bash(htop:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(free:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(env:*)",
      "Bash(export:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ln:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(sudo rm:*)",
      "Bash(:(){ :|:& };:)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(fdisk:*)",
      "Bash(git push --force)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push --force-with-lease origin master)",
      "Bash(git push -f)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd)",
      "Bash(git clean -fdx)",
      "Bash(git checkout -- .)",
      "Bash(git restore --staged .)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(git branch -D trunk)",
      "Bash(* --no-verify)",
      "Bash(* --no-verify *)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(kubectl delete namespace:*)",
      "Bash(kubectl delete pv:*)",
      "Bash(kubectl delete crd:*)",
      "Bash(helm uninstall:*)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(terraform apply -auto-approve)",
      "Bash(aws s3 rb:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws rds delete:*)",
      "Bash(aws dynamodb delete-table:*)",
      "Bash(aws iam delete:*)",
      "Bash(gcloud projects delete:*)",
      "Bash(gcloud sql instances delete:*)",
      "Bash(gcloud compute instances delete:*)",
      "Bash(az group delete:*)",
      "Bash(az vm delete:*)",
      "Bash(docker system prune -a -f --volumes)",
      "Bash(docker volume prune -f)",
      "Bash(docker rm -f $(docker ps -aq))",
      "Bash(psql -c DROP DATABASE:*)",
      "Bash(mysql -e DROP DATABASE:*)",
      "Bash(npm publish)",
      "Bash(pnpm publish)",
      "Bash(yarn publish)",
      "Bash(cargo publish)",
      "Bash(pip publish:*)",
      "Bash(twine upload:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/SessionStart.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PreCompact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/UserPromptSubmit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/Stop.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/Notification.sh"
          }
        ]
      }
    ]
  }
}
