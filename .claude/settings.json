      "Bash(kustomize:*)",
      "Bash(terraform:*)",
      "Bash(terragrunt:*)",
      "Bash(pulumi:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(vercel:*)",
      "Bash(netlify:*)",
      "Bash(flyctl:*)",
      "Bash(railway:*)",
      "Bash(wrangler:*)",
      "Bash(gcloud:*)",
      "Bash(aws:*)",
      "Bash(az:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(mongosh:*)",
      "Bash(sqlite3:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
